  "journal": [
    {
      "text": "Talk to Yenson.",
      "when": [
        "!flag:y_met"
      ]
    },
    {
      "text": "Follow the coast road north to Skelmed.",
      "when": [
        "flag:y_supplies",
        "!flag:been:skelmed"
      ]
    },
    {
      "text": "Find work in Skelmed. Ida at the hunters' lodge, Garran at the forge and old Orlen up in the hills could all use a hand.",
      "when": [
        "flag:been:skelmed",
        "!class:"
      ]
    },
    {
      "text": "You've tried all three. Mira at the guild post says to put your hand on the class stone in her yard.",
      "when": [
        "done:lodge",
        "done:quarry",
        "done:orlen",
        "!class:"
      ]
    },
    {
      "text": "Ida says Skelmed's troubles come down the road from the town inland. (The road inland opens in the next part of the game.)",
      "when": [
        "class:"
      ]
    }
  ],
