  "quests": [
    {
      "id": "water",
      "name": "Water for the pot",
      "giver": "Yenson",
      "desc": "Yenson wants his bucket filled at the spring in the copse south of his shack.",
      "goals": [
        {
          "text": "Fill the bucket at the spring",
          "count": "item:water_bucket",
          "target": 1
        }
      ]
    },
    {
      "id": "firewood",
      "name": "Deadwood",
      "giver": "Yenson",
      "desc": "The fire needs feeding. There's fallen wood all over the copse.",
      "goals": [
        {
          "text": "Gather deadwood in the copse",
          "count": "item:firewood",
          "target": 3
        }
      ]
    },
    {
      "id": "boar",
      "name": "The boar at the spring",
      "giver": "Yenson",
      "desc": "A boar has been tearing up the ground round the spring, and it's getting bolder. Yenson's too old to go after it.",
      "goals": [
        {
          "text": "Kill the boar in the copse",
          "when": "flag:boar_killed"
        }
      ]
    },
    {
      "id": "lodge",
      "name": "Stocking the lodge",
      "giver": "Ida",
      "desc": "The hunters' lodge is down to three hunters and an empty larder. Ida wants hares from Rook's snares in the hills, wood split at the block, and the water butt filled from the hill stream.",
      "goals": [
        {
          "text": "Take hares from Rook's snares in the hills",
          "count": "item:hare",
          "target": 3
        },
        {
          "text": "Split logs at the lodge's chopping block",
          "count": "item:split_wood",
          "target": 4
        },
        {
          "text": "Fill the water butt with two pails from the hill stream",
          "when": "flag:butt_full"
        }
      ]
    },
    {
      "id": "quarry",
      "name": "Ore from the old quarry",
      "giver": "Garran",
      "desc": "Garran's forge has been cold for months for want of ore. He's lent you his pick for the old quarry at the top of the hill path.",
      "goals": [
        {
          "text": "Dig ore from the rock face at the quarry",
          "when": "item:ore>=3|flag:ore_in"
        },
        {
          "text": "Bring the ore to Garran",
          "when": "flag:ore_in"
        },
        {
          "text": "Forge your first piece of gear",
          "when": "flag:smith_done"
        }
      ]
    },
    {
      "id": "orlen",
      "name": "The old mage",
      "giver": "Orlen",
      "desc": "Orlen Vey was mage to the court in Zaron once. Now he grows herbs in the hills above Skelmed, and he's agreed to teach you.",
      "goals": [
        {
          "text": "Learn Draw Water",
          "when": "spell:draw_water"
        },
        {
          "text": "Learn Kindle",
          "when": "spell:kindle"
        },
        {
          "text": "Light Orlen's brazier with Kindle",
          "when": "flag:brazier_lit"
        },
        {
          "text": "Put out the fire at the net shed",
          "when": "flag:fire_out"
        }
      ]
    }
  ]
}
