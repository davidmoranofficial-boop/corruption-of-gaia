    {
      "id": "ida",
      "speaker": "Ida",
      "title": "Ida",
      "safe": true,
      "text": [
        "\"You're the one Yenson pulled out of the sea? Ida. I keep the hunters' lodge, what's left of it. There'll be work for you once you've found your feet.\""
      ],
      "choices": [
        {
          "label": "\"Goodbye.\"",
          "go": "travel"
        }
      ]
    },
    {
      "id": "bess",
      "speaker": "Bess",
      "title": "Bess",
      "safe": true,
      "text": [
        "\"Half the houses on this street are empty. The young ones went inland when the levy went up. Can't say I blame them.\""
      ],
      "choices": [
        {
          "label": "\"Goodbye.\"",
          "go": "travel"
        }
      ]
    },
    {
      "id": "dockhand",
      "speaker": "Dockhand",
      "title": "A dockhand",
      "safe": true,
      "text": [
        "\"Thirty boats, this pier was built for. Three left. King's collector takes half of every catch, and the other half barely feeds us.\""
      ],
      "choices": [
        {
          "label": "\"Goodbye.\"",
          "go": "travel"
