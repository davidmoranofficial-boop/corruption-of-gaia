/* Look: a lantern-lit logbook at night. Deep sea-blue ground, parchment text,
   lantern amber for choices, and the corruption meter in the same sick yellow as
   the corrupted land on David's map. Sizes are for a 1920x1080 reference screen. */

:root {
    --sea: #0d171b;
    --hull: #15242b;
    --hull-hi: #1c2f37;
    --line: #2a3d45;
    --text: #e8dcc2;
    --muted: #9aa9a4;
    --lantern: #e3a64e;
    --taint: #d4c43c;
    --blood: #c8573f;
    --brine: #4f9b97;
    --moss: #7fae6a;
    --dusk: #9d8fd0;
    --ember: #d08a4a;
}

.root {
    flex-grow: 1;
    background-color: var(--sea);
    color: var(--text);
    font-size: 22px;
}

/* ---------- HUD: floats over the world ---------- */

.hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* top: quests on the left, the clock on the right */
.hud-top {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 16px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.hud-quests {
    flex-direction: column;
    width: 320px;
}

.clock-card, .tracker {
    background-color: rgba(13, 23, 27, 0.86);
    border-width: 1px;
    border-color: rgba(232, 220, 194, 0.16);
    border-radius: 8px;
    padding: 10px 14px 8px 14px;
}

/* bottom corners: health and mana on the left, hunger, thirst and stamina on the right */
.hud-corner {
    position: absolute;
    bottom: 28px;
    width: 300px;
    flex-direction: column;
    padding: 10px 14px 4px 14px;
    background-color: rgba(13, 23, 27, 0.72);
    border-width: 1px;
    border-color: rgba(232, 220, 194, 0.12);
    border-radius: 8px;
}

.hud-bottom-left { left: 18px; }
.hud-bottom-right { right: 18px; }
.hud-talking .hud-corner { display: none; }

/* along the very bottom: experience */
.hud-exp {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 16px;
    background-color: rgba(5, 10, 12, 0.85);
    border-top-width: 1px;
    border-top-color: rgba(232, 220, 194, 0.16);
    justify-content: center;
}

.hud-exp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--lantern);
    opacity: 0.75;
}

.hud-exp-text {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--text);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.hud-follower {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 4px;
    white-space: normal;
}

.hud-follower-trouble { color: #e3a64e; }

.party-card {
    padding: 10px 12px;
    margin-bottom: 10px;
    background-color: rgba(14, 22, 26, 0.5);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
}

.party-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.party-state {
    font-size: 14px;
    color: #7fae6a;
}

.party-state-bad { color: #e3a64e; }

.party-btns {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.party-btns .small-btn { margin: 0 6px 6px 0; }

.skill-exp {
    width: 100px;
    font-size: 15px;
    color: var(--muted);
}

.skill-desc {
    font-size: 14px;
    color: var(--muted);
    white-space: normal;
    margin: 0 0 3px 0;
}

.skill-move, .skill-move-locked {
    font-size: 14px;
    white-space: normal;
    margin: 0 0 2px 12px;
}

.skill-move {
    color: var(--text);
}

.skill-move-locked {
    color: var(--muted);
    opacity: 0.7;
}

.hud-small {
    flex-direction: row;
    justify-content: space-between;
}

.hud-small .need {
    width: 47%;
}

.need {
    flex-direction: column;
    margin-bottom: 6px;
}

.need-head {
    flex-direction: row;
    justify-content: space-between;
}

.need-name {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
}

.need-value {
    font-size: 12px;
    color: var(--muted);
}

.need-track {
    height: 7px;
    margin-top: 3px;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 4px;
    overflow: hidden;
}

.need-fill { height: 100%; border-radius: 4px; }
.need-big .need-track { height: 11px; border-radius: 5px; }
.need-big .need-name { font-size: 13px; color: var(--text); }
.need-thin .need-track { height: 4px; }
.need-low .need-name { color: var(--blood); }
.need-low .need-value { color: var(--blood); }

.tracker {
    margin-top: 10px;
    border-left-width: 3px;
    border-left-color: var(--lantern);
}

.tracker-name {
    font-size: 16px;
    color: var(--lantern);
    -unity-font-style: bold;
    margin-bottom: 3px;
    white-space: normal;
}

.tracker-goal, .tracker-goal-done, .tracker-return {
    font-size: 15px;
    color: var(--text);
    white-space: normal;
    margin-bottom: 2px;
}

.tracker-goal-done { color: var(--moss); }
.tracker-return { color: var(--lantern); }

.clock-card {
    align-items: flex-end;
    min-width: 170px;
}

.clock {
    font-size: 28px;
    color: var(--text);
    -unity-font-style: bold;
}

.clock-sub {
    font-size: 14px;
    color: var(--muted);
}

.clock-place {
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--brine);
    margin-top: 4px;
}

.clock-dev {
    font-size: 12px;
    color: var(--taint);
    margin-top: 2px;
}

/* The corruption meter (in the World menu) */

.corruption {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.corruption-track {
    flex-grow: 1;
    max-width: 640px;
    height: 14px;
    background-color: #2b2a14;
    border-width: 1px;
    border-color: #5a5420;
    border-radius: 7px;
    overflow: hidden;
}

.corruption-fill {
    height: 100%;
    background-color: var(--taint);
}

.corruption-value {
    color: var(--taint);
    font-size: 24px;
    -unity-font-style: bold;
    margin-left: 14px;
    min-width: 90px;
}

/* ---------- layout ---------- */

.body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.main-content {
    padding: 200px 56px 190px 56px;
    align-items: center;
}

.main-content.main-flush {
    padding: 0;
}

.story {
    width: 100%;
    max-width: 1300px;
}



/* ---------- story ---------- */

.place {
    font-size: 16px;
    letter-spacing: 3px;
    color: var(--brine);
    margin-bottom: 6px;
}

.title {
    font-size: 40px;
    color: var(--text);
    margin-bottom: 14px;
    white-space: normal;
}

.result {
    white-space: normal;
    font-size: 22px;
    -unity-font-style: italic;
    color: var(--text);
    background-color: var(--hull);
    border-left-width: 3px;
    border-left-color: var(--lantern);
    padding: 12px 16px;
    margin-bottom: 16px;
    max-width: 1150px;
}

.para {
    white-space: normal;
    font-size: 23px;
    color: var(--text);
    margin-bottom: 12px;
    max-width: 1150px;
}

.choices {
    margin-top: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.choice {
    flex-direction: row;
    align-items: center;
    width: 49.5%;
    margin: 0 0 8px 0;
    padding: 9px 14px;
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    -unity-text-align: middle-left;
}

.choice:hover {
    border-color: var(--lantern);
    background-color: var(--hull-hi);
}

.choice:active {
    background-color: var(--line);
}

.choice:disabled {
    opacity: 0.5;
}

.choice-num {
    width: 34px;
    font-size: 20px;
    color: var(--lantern);
    -unity-font-style: bold;
}

.choice-text {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.choice-label {
    white-space: normal;
    font-size: 21px;
    color: var(--text);
}

.choice-meta {
    font-size: 15px;
    color: var(--muted);
    margin-top: 2px;
}

.choice-reason {
    font-size: 16px;
    color: var(--blood);
    margin-top: 2px;
}

/* ---------- sidebar ---------- */

.section {
    margin-bottom: 22px;
}

.section-head {
    font-size: 13px;
    letter-spacing: 3px;
    color: var(--brine);
    margin-bottom: 10px;
}

.who {
    font-size: 28px;
    color: var(--text);
}

.who-sub {
    font-size: 17px;
    color: var(--muted);
    white-space: normal;
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.stat-name {
    width: 130px;
    font-size: 18px;
    color: var(--text);
}

.stat-value {
    width: 36px;
    font-size: 20px;
    color: var(--lantern);
    -unity-font-style: bold;
}

.xp-track {
    flex-grow: 1;
    height: 5px;
    background-color: var(--sea);
    border-radius: 3px;
    overflow: hidden;
}

.xp-fill {
    height: 100%;
    background-color: var(--lantern);
    opacity: 0.6;
}

.line {
    font-size: 18px;
    color: var(--text);
    white-space: normal;
    margin-bottom: 4px;
}

.line-muted {
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
    margin-bottom: 6px;
}

.item-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.small-btn {
    font-size: 16px;
    color: var(--text);
    background-color: var(--hull-hi);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
    padding: 4px 10px;
    margin: 0 0 0 8px;
}

.small-btn:hover { border-color: var(--lantern); background-color: var(--line); }
.small-btn:disabled { opacity: 0.4; }

.wide-btn {
    margin: 6px 0 0 0;
    padding: 8px 10px;
    -unity-text-align: middle-left;
}

.journal-entry {
    font-size: 18px;
    color: var(--text);
    white-space: normal;
    margin-bottom: 8px;
    padding-left: 10px;
    border-left-width: 2px;
    border-left-color: var(--lantern);
}

/* ---------- toasts ---------- */

.toasts {
    position: absolute;
    right: 18px;
    top: 150px;
    flex-direction: column;
    align-items: flex-end;
}

.toast {
    font-size: 18px;
    color: var(--sea);
    background-color: var(--lantern);
    padding: 8px 14px;
    border-radius: 4px;
    margin-top: 8px;
}

/* ---------- title and creation screens ---------- */

.screen {
    flex-grow: 1;
}

.screen-content {
    align-items: center;
    padding: 44px 40px 44px 40px;
}

.screen-inner {
    width: 1000px;
    max-width: 100%;
}

.screen-wide {
    width: 1500px;
}

.cols {
    flex-direction: row;
}

.col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 40px;
}

.game-title {
    font-size: 96px;
    white-space: normal;
    color: var(--text);
    -unity-text-align: middle-center;
}

.game-sub {
    font-size: 22px;
    letter-spacing: 6px;
    color: var(--taint);
    -unity-text-align: middle-center;
    margin-bottom: 40px;
}

.field-label {
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--brine);
    margin: 18px 0 8px 0;
}

.option-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.option {
    flex-direction: column;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 200px;
    margin: 0 10px 10px 0;
    padding: 12px 16px;
    background-color: var(--hull);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 6px;
    -unity-text-align: upper-left;
}

.option:hover { border-color: var(--muted); background-color: var(--hull-hi); }
.option.selected { border-color: var(--lantern); background-color: var(--hull-hi); }

.option-chip {
    flex-grow: 0;
    flex-basis: auto;
    min-width: 0;
    padding: 10px 18px;
}

.option-name {
    font-size: 24px;
    color: var(--text);
}

.option-desc {
    font-size: 17px;
    color: var(--muted);
    white-space: normal;
    margin-top: 4px;
}

.primary {
    font-size: 26px;
    color: var(--sea);
    background-color: var(--lantern);
    border-width: 0;
    border-radius: 6px;
    padding: 12px 40px;
    margin: 24px 0 0 0;
    align-self: flex-start;
}

.primary:hover { background-color: #f0b964; }

.secondary:hover { border-color: var(--lantern); background-color: var(--hull-hi); }

.secondary {
    font-size: 22px;
    color: var(--text);
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    padding: 10px 30px;
    margin: 24px 0 0 16px;
    align-self: flex-start;
}

.error {
    color: var(--blood);
    font-size: 18px;
    margin-top: 12px;
}

.name-field {
    margin: 0;
    width: 520px;
}

.name-field .unity-base-text-field__input {
    font-size: 28px;
    color: var(--text);
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    padding: 10px 14px;
    --unity-cursor-color: var(--lantern);
    --unity-selection-color: rgba(227, 166, 78, 0.35);
}

.alloc-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.alloc-name {
    width: 180px;
    font-size: 22px;
}

.alloc-value {
    width: 60px;
    font-size: 26px;
    color: var(--lantern);
    -unity-text-align: middle-center;
}

.alloc-bonus {
    font-size: 16px;
    color: var(--brine);
    margin-left: 12px;
}

/* ---------- menu bar and menus ---------- */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(5, 10, 12, 0.78);
    align-items: center;
    justify-content: center;
}

.panel {
    width: 1240px;
    max-width: 92%;
    height: 86%;
    background-color: var(--sea);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 10px;
}

.panel-content {
    padding: 0 0 22px 0;
}

.panel-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    margin-bottom: 18px;
    background-color: var(--hull);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.panel-content > .cols {
    padding: 0 28px;
}

.panel-title {
    font-size: 20px;
    letter-spacing: 4px;
    color: var(--lantern);
    margin-left: 10px;
}

/* ---------- the menu wheel (I) ---------- */

.wheel {
    width: 560px;
    height: 560px;
}

.wheel-ring {
    position: absolute;
    left: 75px;
    top: 75px;
    width: 410px;
    height: 410px;
    border-radius: 205px;
    border-width: 2px;
    border-color: rgba(232, 220, 194, 0.18);
    background-color: rgba(13, 23, 27, 0.55);
}

.wheel-item {
    position: absolute;
    width: 124px;
    height: 124px;
    margin: 0;
    padding: 0;
    border-radius: 62px;
    border-width: 2px;
    border-color: var(--line);
    background-color: var(--hull);
    align-items: center;
    justify-content: center;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.12s;
}

.wheel-item-on {
    border-color: var(--lantern);
    background-color: var(--hull-hi);
    scale: 1.1 1.1;
}

.wheel-item-name {
    font-size: 17px;
    color: var(--text);
    -unity-font-style: bold;
}

.wheel-item-on .wheel-item-name { color: var(--lantern); }

.wheel-item-key {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
}

.wheel-centre {
    position: absolute;
    left: 165px;
    top: 165px;
    width: 230px;
    height: 230px;
    border-radius: 115px;
    background-color: var(--sea);
    border-width: 1px;
    border-color: var(--line);
    align-items: center;
    justify-content: center;
    padding: 0 26px;
}

.wheel-name {
    font-size: 22px;
    letter-spacing: 3px;
    color: var(--lantern);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.wheel-desc {
    font-size: 14px;
    color: var(--text);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.wheel-help {
    font-size: 11px;
    color: var(--muted);
}

.panel-head-right {
    flex-direction: row;
}

.panel-head-right .close-btn { margin-left: 8px; }

.close-btn {
    font-size: 15px;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    padding: 6px 12px;
}

.close-btn:hover { color: var(--text); border-color: var(--lantern); }

.slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 72px;
    height: 72px;
    margin: 0 8px 8px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--hull);
    border-width: 2px;
    border-color: var(--line);
    border-radius: 8px;
}

.slot:hover { border-color: var(--muted); }
.slot-selected { border-color: var(--lantern); background-color: var(--hull-hi); }

.slot .item-icon {
    margin-right: 0;
}

.slot-count {
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 15px;
    color: var(--text);
    -unity-font-style: bold;
}

.detail {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 6px;
    padding: 14px;
    background-color: var(--hull);
    border-radius: 8px;
}

.detail .item-icon {
    margin-right: 16px;
}

.detail-name {
    font-size: 22px;
    color: var(--text);
    margin-bottom: 4px;
}

.detail-btn {
    align-self: flex-start;
    margin: 8px 0 0 0;
    padding: 6px 22px;
}

.quest {
    padding: 12px 16px;
    margin-bottom: 10px;
    background-color: var(--hull);
    border-left-width: 3px;
    border-left-color: var(--lantern);
    border-radius: 6px;
}

.quest-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.quest-name {
    font-size: 21px;
    color: var(--text);
}

.quest-giver {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--brine);
}

.quest-goal, .quest-goal-done, .quest-return {
    font-size: 17px;
    color: var(--text);
    white-space: normal;
    margin-top: 2px;
}

.quest-goal-done { color: var(--moss); }
.quest-return { color: var(--lantern); }

.big-line {
    font-size: 26px;
    color: var(--text);
}

.item-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.need-row {
    margin-bottom: 14px;
}

.need-row .need {
    width: auto;
    margin-right: 0;
}

/* A list of options, one per line (used for backgrounds). Avoids wrapped rows,
   which UI Toolkit sizes badly when the items stretch. */
.option-list {
    flex-direction: column;
}

.option-line {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-basis: auto;
    min-width: 0;
    margin: 0 0 8px 0;
    padding: 10px 16px;
}

.option-line-name {
    width: 210px;
    font-size: 21px;
    color: var(--text);
}

.option-line-desc {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
}

.option-line-bonus {
    font-size: 16px;
    color: var(--brine);
    margin-left: 12px;
}

/* ---------- battle ---------- */

.battle {
    width: 100%;
}

.battle-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.battle-round {
    font-size: 16px;
    letter-spacing: 3px;
    color: var(--muted);
}

.arena {
    background-color: #0a1316;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 10px;
    padding: 24px 28px;
    height: 600px;
    justify-content: space-between;
}

.arena-top {
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
}

.arena-bottom {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.arena-mid {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.fighter-card {
    width: 470px;
    padding: 14px 18px;
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
}

.fighter-card.flash {
    background-color: #5a2a22;
    border-color: var(--blood);
}

.fighter-name-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.fighter-name {
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.fighter-sub {
    font-size: 15px;
    color: var(--muted);
    margin-top: 6px;
}

.fighter-bar, .fighter-bar-big {
    margin-top: 4px;
}

.fighter-bar-big .need-track {
    height: 16px;
}

.bar-anim {
    transition-property: width;
    transition-duration: 0.45s;
    transition-timing-function: ease-out;
}

.portrait {
    width: 230px;
    height: 230px;
    margin-left: 22px;
    border-width: 2px;
    border-color: var(--line);
    border-radius: 8px;
    background-color: var(--hull);
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.portrait-letter {
    font-size: 120px;
    color: #3d5560;
    -unity-font-style: bold;
}

.portrait-down {
    opacity: 0.3;
    rotate: 8deg;
}

.intent {
    align-items: center;
    padding: 12px 26px;
    border-width: 1px;
    border-color: #5b4526;
    border-radius: 8px;
    background-color: #1a1710;
    max-width: 760px;
}

.intent-head {
    font-size: 14px;
    letter-spacing: 3px;
    color: var(--lantern);
    margin-bottom: 4px;
}

.intent-text {
    font-size: 23px;
    -unity-font-style: italic;
    white-space: normal;
    -unity-text-align: middle-center;
}

.intent-order {
    font-size: 15px;
    color: var(--muted);
    margin-top: 6px;
}

.log-line, .log-line-new {
    white-space: normal;
    font-size: 18px;
    color: var(--muted);
    margin-top: 4px;
    -unity-text-align: lower-right;
}

.log-line-new {
    font-size: 21px;
    color: var(--text);
}

.commands {
    flex-direction: row;
    margin-top: 16px;
    height: 104px;
}

.commands-placeholder {
    margin-top: 16px;
    height: 104px;
}

.command {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px 0 0;
    padding: 10px 16px;
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
    align-items: flex-start;
    justify-content: center;
}

.command:hover { border-color: var(--lantern); background-color: var(--hull-hi); }
.command:disabled { opacity: 0.4; }

.command-num {
    font-size: 16px;
    color: var(--lantern);
    -unity-font-style: bold;
}

.command-name {
    font-size: 26px;
    color: var(--text);
    white-space: normal;
}

.command-sub {
    font-size: 14px;
    color: var(--muted);
    white-space: normal;
}

.timing {
    margin-top: 16px;
    height: 104px;
    justify-content: center;
}

.timing-head {
    font-size: 16px;
    letter-spacing: 3px;
    color: var(--lantern);
    margin-bottom: 10px;
}

.timing-track {
    height: 44px;
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    overflow: hidden;
}

.timing-good {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: #5b4526;
}

.timing-perfect {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: var(--lantern);
}

.timing-marker {
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 6px;
    margin-left: -3px;
    background-color: var(--text);
}

.pop {
    position: absolute;
    top: 10px;
    right: 24px;
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}

.pop-hit { color: #f0e2c4; }
.pop-crit { color: #ff7a4d; font-size: 60px; }
.pop-glance { color: var(--muted); font-size: 34px; }
.pop-heal { color: var(--moss); font-size: 30px; }
.pop-perfect { color: #f2d36b; font-size: 40px; }
.pop-good { color: var(--lantern); font-size: 32px; }
.pop-miss { color: var(--muted); font-size: 32px; }

/* ---------- gear ---------- */

.rank-badge {
    font-size: 18px;
    -unity-font-style: bold;
    width: 34px;
    height: 34px;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-radius: 6px;
    margin-right: 12px;
    flex-shrink: 0;
}

.gear-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.gear-slot {
    width: 110px;
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--muted);
    flex-shrink: 0;
}

.gear-empty {
    font-size: 18px;
    color: #4d5f60;
}

.gear-stats {
    font-size: 16px;
    color: var(--moss);
    white-space: normal;
}

.gear-trait {
    font-size: 16px;
    color: var(--lantern);
    white-space: normal;
}

/* ---------- the walkable world ---------- */

.world-view {
    overflow: hidden;
    background-color: #0b1215;
}

.world-layer {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.world-over, .world-night {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.world-night { background-color: rgba(8, 14, 34, 0.5); }

/* weather over the world */
.weather-tint, .weather-fx {
    position: absolute;
    left: 0;
    top: 0;
}
.weather-tint { right: 0; bottom: 0; }
.weather-tile {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}
.weather-drizzle { background-color: rgba(60, 80, 100, 0.14); }
.weather-rain { background-color: rgba(40, 60, 85, 0.24); }
.weather-storm { background-color: rgba(20, 28, 45, 0.42); }
.weather-fog { background-color: rgba(200, 208, 210, 0.38); }
.weather-heat { background-color: rgba(255, 190, 90, 0.12); }

/* how you're doing: cold, wet, wounds */
.hud-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}
.hud-chip, .hud-chip-bad {
    font-size: 12px;
    padding: 1px 6px;
    margin: 0 4px 3px 0;
    border-radius: 3px;
    color: var(--text);
    background-color: rgba(70, 103, 106, 0.55);
}
.hud-chip-bad { background-color: rgba(122, 51, 40, 0.75); }
.clock-weather {
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
}
.wound-who {
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--brine);
    margin: 6px 0 4px 0;
}
.wound-done {
    font-size: 14px;
    color: #7fae6a;
    margin: 4px 10px 6px 0;
}
.line-warn {
    font-size: 15px;
    color: #e3a64e;
    white-space: normal;
    margin-bottom: 4px;
}

.walker {
    position: absolute;
    overflow: hidden;
}

.walker-sheet {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.world-thing {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.world-name {
    position: absolute;
    left: 14px;
    top: 12px;
    font-size: 17px;
    letter-spacing: 3px;
    color: var(--text);
    background-color: rgba(13, 23, 27, 0.8);
    border-radius: 4px;
    padding: 4px 12px;
}

.world-help {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: 26px;
    font-size: 14px;
    color: var(--muted);
    background-color: rgba(13, 23, 27, 0.7);
    border-radius: 6px;
    padding: 5px 12px;
    white-space: nowrap;
}

.world-prompt {
    position: absolute;
    left: 50%;
    bottom: 64px;
    translate: -50% 0;
    font-size: 20px;
    color: var(--sea);
    background-color: var(--lantern);
    border-radius: 5px;
    padding: 6px 16px;
    -unity-font-style: bold;
}

.dialogue {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    width: 1240px;
    max-width: 92%;
    bottom: 22px;
    max-height: 58%;
    background-color: rgba(13, 23, 27, 0.96);
    border-width: 2px;
    border-color: rgba(232, 220, 194, 0.55);
    border-radius: 10px;
    padding: 20px 28px 16px 28px;
}

.dialogue-scroll {
    flex-shrink: 1;
}

.dialogue-title {
    font-size: 26px;
    color: var(--lantern);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.dialogue-speaker {
    position: absolute;
    top: -22px;
    left: 20px;
    padding: 4px 16px;
    font-size: 20px;
    color: var(--lantern);
    -unity-font-style: bold;
    background-color: rgba(13, 23, 27, 1);
    border-width: 3px;
    border-color: var(--text);
    border-radius: 6px;
}

.dialogue-text {
    font-size: 22px;
    color: var(--text);
    white-space: normal;
    margin-bottom: 10px;
}

.dialogue-more {
    align-self: flex-end;
    font-size: 16px;
    color: var(--lantern);
}

/* ---------- forge ---------- */

.forge {
    width: 100%;
    max-width: 1300px;
}

.forge-steps {
    flex-direction: row;
    margin: 6px 0 14px 0;
}

.forge-step {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    justify-content: space-between;
    margin-right: 8px;
    padding: 10px 16px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
    background-color: var(--hull);
    opacity: 0.55;
}

.forge-step-now { opacity: 1; border-color: var(--lantern); }
.forge-step-done { opacity: 0.9; }

.forge-step-name {
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--text);
}

.forge-step-score {
    font-size: 18px;
    color: var(--lantern);
    -unity-font-style: bold;
}

.forge-panel {
    background-color: #0a1316;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 10px;
    padding: 28px 36px;
    height: 470px;
    justify-content: flex-start;
}

.metal {
    height: 70px;
    width: 70%;
    align-self: center;
    border-radius: 6px;
    margin-bottom: 28px;
    border-width: 2px;
    border-color: #000000;
}

.gauge {
    height: 34px;
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
}

.gauge-band {
    position: absolute;
    top: 0;
    bottom: 0;
    background-color: #6b3a1c;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: var(--lantern);
}

.gauge-needle {
    position: absolute;
    top: -6px;
    bottom: -6px;
    width: 6px;
    margin-left: -3px;
    background-color: var(--text);
}

.gauge-labels {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.gauge-label {
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--muted);
}

.bellows {
    margin-top: 18px;
    align-self: center;
    padding: 12px 30px;
    border-width: 1px;
    border-color: var(--lantern);
    border-radius: 8px;
    background-color: var(--hull);
}

.bellows:hover { background-color: var(--hull-hi); }

.bellows-label {
    font-size: 18px;
    color: var(--lantern);
}

.forge-timer {
    height: 8px;
    margin-top: 18px;
    background-color: var(--hull);
    border-radius: 4px;
    overflow: hidden;
}

.forge-timer-fill {
    height: 100%;
    width: 100%;
    background-color: var(--muted);
}

.forge-bar {
    height: 54px;
}

.strike-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 18px;
}

.strike-done, .strike-left {
    width: 22px;
    height: 22px;
    margin: 0 6px;
    border-radius: 11px;
    border-width: 2px;
    border-color: var(--lantern);
}

.strike-done { background-color: var(--lantern); }

.quench-strip {
    flex-direction: row;
    height: 54px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    overflow: hidden;
}

.quench-seg {
    flex-grow: 1;
    height: 100%;
}

.quench-mark {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    margin-left: -2px;
    background-color: #9fd8ff;
}

.forge-hint {
    margin-top: 24px;
    font-size: 20px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

.forge-hint-start {
    color: var(--lantern);
    font-size: 26px;
    -unity-font-style: bold;
}

/* forge: hammer (click the dots) */

.anvil-area {
    height: 290px;
    border-radius: 8px;
    background-color: #0f1b1f;
    overflow: hidden;
}

.anvil-part {
    position: absolute;
}

.gold-ring, .close-ring, .strike-dot {
    position: absolute;
}

.gold-ring {
    border-width: 4px;
    border-color: #f2d36b;
    opacity: 0.9;
}

.close-ring {
    border-width: 3px;
    border-color: #f0e2c4;
}

.strike-dot-core {
    position: absolute;
    left: 9px;
    top: 9px;
    right: 9px;
    bottom: 9px;
    border-radius: 999px;
    background-color: #fff3c8;
    border-width: 2px;
    border-color: #f2d36b;
}

/* forge: quench (hold it under the water) */

.trough {
    height: 230px;
    width: 60%;
    align-self: center;
    margin-top: 18px;
    overflow: hidden;
}

.quench-blade {
    position: absolute;
    left: 20%;
    width: 60%;
    height: 34px;
    border-radius: 4px;
    border-width: 2px;
    border-color: #000000;
    transition-property: top;
    transition-duration: 0.15s;
}

.trough-water {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    background-color: rgba(40, 90, 120, 0.75);
    border-width: 3px;
    border-top-width: 0;
    border-color: #55585c;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.steam {
    position: absolute;
    left: 0;
    right: 0;
    top: 60px;
    font-size: 22px;
    letter-spacing: 6px;
    color: #dfe9ee;
    -unity-text-align: middle-center;
}

/* ---------- sprites and the paper doll ---------- */

.doll {
    flex-shrink: 0;
}

.doll-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.sprite-hit .doll-layer, .enemy-sprite.sprite-hit {
    -unity-background-image-tint-color: #ff7a66;
}

.enemy-sprite {
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.item-icon, .item-icon-empty {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    margin-right: 10px;
    -unity-background-scale-mode: stretch-to-fill;
}

.item-icon-empty {
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
}

.worn {
    flex-direction: row;
    align-items: flex-start;
}

.doll-frame {
    padding: 14px;
    margin-right: 22px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
    background-color: #0a1316;
}

.worn-slots {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.create-look {
    margin-top: 18px;
    align-self: flex-start;
    padding: 14px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 8px;
    background-color: #0a1316;
}

.battle-me {
    margin-right: 22px;
    justify-content: flex-end;
}

/* ---------- battle stage (overrides) ---------- */

.battle .arena {
    flex-grow: 1;
    flex-shrink: 1;
    height: auto;
    padding: 0;
    overflow: hidden;
    border-width: 2px;
    border-color: #2a3a3e;
    border-radius: 10px;
    -unity-background-scale-mode: scale-and-crop;
    background-color: #1d2a2e;
}

.spot-player, .spot-enemy {
    position: absolute;
    bottom: 6%;
    align-items: center;
    justify-content: flex-end;
}

.spot-player { left: 17%; }

.spot-follower {
    position: absolute;
    bottom: 9%;
    left: 5%;
    align-items: center;
    justify-content: flex-end;
}

.follower-tag {
    width: 120px;
    margin-top: 6px;
    padding: 4px 8px;
    background-color: rgba(14, 22, 26, 0.86);
    border-radius: 6px;
}

.follower-name {
    font-size: 14px;
    color: var(--text);
    -unity-font-style: bold;
}

.boss-tag {
    font-size: 13px;
    color: #e3a64e;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 2px 0 4px 0;
}
.spot-enemy { right: 15%; }

.battle .fighter-card {
    position: absolute;
    top: 18px;
    width: 440px;
    background-color: rgba(14, 22, 26, 0.86);
}

.card-player { left: 18px; }
.card-enemy { right: 18px; }

.card-enemy .intent-text {
    margin-top: 10px;
    font-size: 19px;
    color: #e2c27a;
    -unity-text-align: upper-left;
}

.card-enemy .intent-order {
    font-size: 14px;
    margin-top: 4px;
}

.battle .battle-log {
    height: 86px;
    margin: 10px 4px 6px 4px;
    justify-content: flex-end;
}

.battle .log-line, .battle .log-line-new {
    -unity-text-align: lower-left;
}

.battle .portrait-letter {
    font-size: 160px;
}

/* ---------- dev mode ---------- */

.dev-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.dev-btn {
    margin: 0 8px 8px 0;
    padding: 8px 14px;
    font-size: 17px;
    color: var(--text);
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
}

.dev-btn:hover { border-color: var(--lantern); background-color: var(--hull-hi); }

.dev-chip {
    margin: 0 5px 5px 0;
    padding: 3px 8px;
    font-size: 13px;
    color: var(--muted);
    background-color: var(--hull);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
}

.dev-chip:hover { color: var(--text); border-color: var(--lantern); }

.dev-gear-name {
    width: 260px;
    font-size: 16px;
    color: var(--text);
}

.dev-rank {
    width: 34px;
    height: 30px;
    margin: 0 4px 0 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    background-color: var(--hull);
    border-width: 2px;
    border-radius: 5px;
}

/* ---------- effects (GameUI.Fx.cs) ---------- */

.fx {
    position: absolute;
    overflow: hidden;
}

.fx-sheet {
    position: absolute;
    left: 0;
    top: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.world-light, .world-vignette, .world-fade, .screen-flash, .battle-intro {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.world-glow {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.world-vignette {
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0;
}

.world-fade {
    background-color: rgb(5, 8, 10);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.55s;
    transition-timing-function: ease-out;
}
.world-fade-out { opacity: 0; }

.screen-flash {
    background-color: rgba(255, 246, 225, 0.75);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}
.screen-flash-out { opacity: 0; }

.battle-intro {
    background-color: rgb(250, 244, 230);
    opacity: 1;
    scale: 1 1;
    transition-property: opacity, scale;
    transition-duration: 0.7s;
    transition-timing-function: ease-in;
}
.battle-intro-out { opacity: 0; scale: 1.6 1.6; }

/* ---------- sound settings ---------- */

.volume-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.volume-name {
    width: 100px;
    font-size: 16px;
    color: var(--text);
}

.volume-slider {
    flex-grow: 1;
    margin: 0 12px;
}

.volume-value {
    width: 52px;
    font-size: 14px;
    color: var(--muted);
    -unity-text-align: middle-right;
}

/* ---------- skill points ---------- */
.skill-points { font-size: 16px; letter-spacing: 2px; color: var(--muted); margin-top: 6px; }
.skill-points-have { color: var(--lantern); -unity-font-style: bold; }
.move-row { flex-direction: row; align-items: center; justify-content: space-between; }
.move-row > Label { flex-shrink: 1; min-width: 0; white-space: normal; }
.skill-move-ready { color: var(--lantern); font-size: 14px; margin: 2px 0 2px 12px; }
.move-why { font-size: 12px; color: var(--muted); margin-left: 8px; }
